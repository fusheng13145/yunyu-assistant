{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "author": "",
  "description": "云谕助手 - 前端项目",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:test": "vue-tsc -b && vite build --mode test",
    "preview": "vite preview",
    "type:check": "vue-tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,vue}\"",
    "lint:fix": "eslint \"src/**/*.{ts,vue}\" --fix",
    "check:auth": "node ../scripts/check-auth-session.mjs",
    "check:notification": "node ../scripts/check-notification.mjs",
    "check:kb-flag": "node ../scripts/check-knowledgebase-flag.mjs",
    "check:history-record": "node ../scripts/check-history-record.mjs"
  },
  "dependencies": {
    "lucide-vue-next": "^0.525.0",
    "vue": "^3.5.34",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.2.0",
    "vue-tsc": "^3.2.8"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "@rollup/rollup-linux-*"
      ]
    }
  }
}
