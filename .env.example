# ============================================
# 云谕助手 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# 所有带 [REQUIRED] 的字段为必填项
#
# ⚠️ Spring Boot 不会自动读取 .env（JVM 无 dotenv 依赖）。部署时必须显式导出：
#    shell:  set -a && . ./.env && set +a && java -jar backend-*.jar
#    systemd: EnvironmentFile=/opt/yunyu/.env
#    本地开发脚本 start-backend.bat 自带 dev 默认值，不读本文件
# ============================================

# --- 数据库配置 ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yunyu_assistant
DB_USER=[REQUIRED]
DB_PASSWORD=[REQUIRED]

# --- Spring AI / 大模型（v2.29 起硬依赖：未注入 OPENAI_API_KEY 后端启动即失败，不再静默降级）---
OPENAI_API_KEY=[REQUIRED]
OPENAI_BASE_URL=https://platform.deepseek.com/v1
# 全局默认模型与温度（助手级参数在应用内覆盖）
AI_MODEL=deepseek-chat
AI_TEMPERATURE=0.7

# --- JWT 认证（必须 ≥ 32 字节随机字符串，可用: openssl rand -base64 32）---
JWT_SECRET=[REQUIRED]
JWT_EXPIRATION=86400000
# 刷新令牌有效期（毫秒），默认 7 天
JWT_REFRESH_EXPIRATION=604800000

# --- RAGFlow 知识库服务（选配；留空则知识库检索不可用，对话仍可用）---
# 注意：本文件被 source 进环境时，占位值会真的被当成凭据使用，未启用的项请留空而不是留 [REQUIRED]
RAGFLOW_API_KEY=
# 例：https://demo.ragflow.io
RAGFLOW_ENDPOINT=

# --- 全网搜索服务（选配；二者缺一则 web_search / deep_research 不注册）---
SEARCH_API_KEY=
# 例：https://api.bochaai.com/v1/web-search
SEARCH_ENDPOINT=

# --- 高德天气 API（选配；留空则 get_weather 不注册）---
WEATHER_API_KEY=

# --- 图像生成工具（OpenAI 兼容 images 接口；留空则 generate_image 工具不注册）---
IMAGE_API_KEY=
IMAGE_ENDPOINT=https://api.openai.com/v1/images/generations
IMAGE_MODEL=dall-e-3

# --- 视频生成工具（OpenAI 兼容 videos 异步任务；留空则 generate_video/query_video 不注册）---
# 查询地址按 {VIDEO_ENDPOINT}/{jobId} 拼接，非此契约的服务商需改 VideoTool 解析逻辑
VIDEO_API_KEY=
VIDEO_ENDPOINT=https://api.openai.com/v1/videos
VIDEO_MODEL=sora-2

# --- 网页正文读取工具（免第三方密钥；开启后服务端会出网访问模型给出的公网地址，默认关闭）---
WEBFETCH_ENABLED=false
WEBFETCH_MAX_BYTES=200000

# --- 深度研究工具（检索 + 多篇正文抓取；需 SEARCH_API_KEY/SEARCH_ENDPOINT 与 WEBFETCH_ENABLED=true 同时就绪才注册）---
# 默认抓取网页数（模型可用 maxSources 覆盖，服务端钳制 1-5）
RESEARCH_MAX_SOURCES=3

# --- RustPBX 语音 WebSocket 服务 ---
RUSTPBX_ENDPOINT=ws://your-rustpbx-server:8080
# 沉默追问超时（秒）
RUSTPBX_SILENCE_TIMEOUT=30
# 是否启用 VAD 打断 TTS
RUSTPBX_BREAK_ON_VAD=true

# --- 语音识别参数（ASR/TTS 由 RustPBX 网关代理，腾讯云凭据配在网关侧，此处仅需模型）---
ASR_PROVIDER=tencent
ASR_MODEL=16k_zh

# --- 语音合成参数（TTS 服务商由网关固定为 tencent）---
TTS_MODEL=cosvoice-v1
TTS_SPEAKER=longxiaochun

# --- 服务端口（可选，默认 8080）---
SERVER_PORT=8080
# 监听地址（v2.30，默认 0.0.0.0＝Boot 原行为）：单机反代部署可设 127.0.0.1，
# 使"业务端口不出机器"由内核保证，而不只是依赖云安全组
SERVER_ADDRESS=0.0.0.0
# 管理端口（默认与 SERVER_PORT 同端口）：公网实例建议改成独立端口（如 9080）后
# 安全组完全不放行它 ⇒ /actuator 连免鉴权可读的残余面都没有；同端口时靠反代 deny 兜底
MANAGEMENT_SERVER_PORT=8080
# 管理端口监听地址。**默认注释掉＝不设置**，因为 Spring Boot 的两个方向不对称（v2.31 真实首跑实测）：
# - 与业务同端口时设了它就抛 IllegalStateException（"Management-specific server address cannot be
#   configured as the management server is not listening on a separate port"）⇒ 整个应用起不来
# - 端口独立时它又**不继承** server.address（不设即 /actuator 绑全网卡）⇒ 由 ManagementAddressGuard
#   在启动时拒绝，错误信息会指出这一项
# 所以：只有把 MANAGEMENT_SERVER_PORT 改成与 SERVER_PORT 不同的值时，才取消注释并设值
# MANAGEMENT_SERVER_ADDRESS=127.0.0.1
# 前端来源白名单（逗号分隔，v2.30 提为变量，默认＝下面的本地端口清单）
# HTTP 跨域与 WebSocket 握手共用同一份。浏览器 WS 握手一定带 Origin，站点上公网后
# 必须把正式域名（含 https）加进来，否则聊天/语音在握手阶段就 403
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000

# 未认证 WebSocket 连接的存活上限（毫秒，v2.32）
# /ws/* 与 /ws-voice/* 允许免令牌握手（认证在首条 auth 消息），Tomcat 服务端又不回收空闲会话，
# 故应用层定时关闭"超时仍未认证"的连接；认证成功即摘除登记，正常用户不受影响。
# 调小可更快释放连接槽，但弱网用户可能在发出 auth 帧前被踢；判定精度另有 10 秒扫描周期
WS_UNAUTHENTICATED_IDLE_MS=30000

# --- 公网部署可观测性与暴露面（v2.29）---
# /actuator 不在 /api/** 拦截器覆盖范围内（免鉴权），默认只回 UP/DOWN；
# 需要数据库/磁盘明细时临时设为 when-authorized 并在反代层封掉 /actuator
HEALTH_SHOW_DETAILS=never
# SQL 语句日志级别（默认 INFO；本地调试改 DEBUG）
MAPPER_LOG_LEVEL=INFO
# 日志文件路径（留空=仅控制台；Boot 默认按天 + 10MB 轮转、保留 7 天）
LOG_FILE=

# --- Redis（多实例共享状态：限流/令牌黑名单/登录锁定）---
# 生产多实例部署时设为 true，未启用则降级单实例内存实现
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- WebRTC ICE 服务器（JSON 数组；生产配置 TURN 穿透对称 NAT）---
# 示例: [{"urls":"turn:turn.example.com:3478","username":"user","credential":"pass"},{"urls":"stun:stun.example.com:3478"}]
# 为空时前端回退默认 Google STUN
WEBRTC_ICE_SERVERS=[]

# --- 通话录音存储目录（前端 MediaRecorder 上传的 {callId}.webm 落盘路径）---
RECORDING_DIR=./data/recordings

# --- 数据归档（P2-9 容量治理）---
# 定时归档开关（默认关；管理端 /api/admin/archive/run 可手动触发）
ARCHIVE_SCHEDULE_ENABLED=false
ARCHIVE_CRON=0 0 3 * * ?
ARCHIVE_BATCH_SIZE=500
# 各表保留天数（超期即归档到 *_archive 并物理删除源表）
ARCHIVE_RECORDS_RETENTION_DAYS=180
ARCHIVE_CALL_RECORDS_RETENTION_DAYS=180
ARCHIVE_AUDIT_LOGS_RETENTION_DAYS=180
# 归档分布式锁 TTL（毫秒；v2.19，多实例同刻仅一个实例执行）
APP_ARCHIVE_LOCK_TTL_MS=600000

# --- 用量配额默认值（P2-10；org/user 无配额配置记录时的兜底上限，管理端 /api/admin/quotas 可覆盖）---
# ⚠️ 公网开放注册时建议下调（默认值是内网自用量级）：日对话条数直接等于 LLM 成本上限，
#    建议 APP_QUOTA_DAILY_MSG=100；配合管理端"配额"页按用户/组织覆盖单点额度
APP_QUOTA_ASSISTANT_LIMIT=50
APP_QUOTA_DAILY_CALL=20
APP_QUOTA_DAILY_CALL_SEC=3600
APP_QUOTA_DAILY_MSG=500

# --- PSTN 外呼网关（P2-17；可插拔 HTTP 网关，未配置 gateway-url 时外呼任务置 FAILED）---
# 网关地址：POST JSON {taskId, assistantId, phoneNumber, callbackUrl}
PSTN_GATEWAY_URL=
# 本系统 PSTN 回调端点（供网关回调）
PSTN_CALLBACK_URL=
# PSTN 网关回调鉴权 Token（/api/open/callbacks/pstn 校验 X-Gateway-Token）
PSTN_CALLBACK_TOKEN=
# DIALING 滞留超时阈值毫秒（v2.18，超过置 FAILED）/ 超时扫描周期毫秒
PSTN_TIMEOUT_MS=120000
PSTN_SCAN_INTERVAL_MS=30000

# --- Webhook 回调（P2-17；事件投递到第三方应用配置的 webhook_url，异步 + 失败重试指数退避）---
WEBHOOK_ENABLED=true
# 失败重试最大次数 / 基础延迟毫秒 / 定时扫描周期毫秒
WEBHOOK_RETRY_MAX_ATTEMPTS=3
WEBHOOK_RETRY_BASE_DELAY_MS=5000
WEBHOOK_RETRY_INTERVAL_MS=60000