# ============================================
# 云谕助手 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值
# 所有带 [REQUIRED] 的字段为必填项
# ============================================

# --- 数据库配置 ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=yunyu_assistant
DB_USER=[REQUIRED]
DB_PASSWORD=[REQUIRED]

# --- Spring AI / 大模型 ---
OPENAI_API_KEY=[REQUIRED]
OPENAI_BASE_URL=https://platform.deepseek.com/v1

# --- JWT 认证（必须 ≥ 32 字节随机字符串，可用: openssl rand -base64 32）---
JWT_SECRET=[REQUIRED]
JWT_EXPIRATION=86400000

# --- RAGFlow 知识库服务 ---
RAGFLOW_API_KEY=[REQUIRED]
RAGFLOW_ENDPOINT=https://demo.ragflow.io

# --- 全网搜索服务 ---
SEARCH_API_KEY=[REQUIRED]
SEARCH_ENDPOINT=https://api.bochaai.com/v1/web-search

# --- 高德天气 API ---
WEATHER_API_KEY=[REQUIRED]

# --- RustPBX 语音 WebSocket 服务 ---
RUSTPBX_ENDPOINT=ws://your-rustpbx-server:8080

# --- 腾讯云 ASR 语音识别 ---
ASR_PROVIDER=tencent
ASR_MODEL=16k_zh
ASR_APP_ID=[REQUIRED]
ASR_SECRET_ID=[REQUIRED]
ASR_SECRET_KEY=[REQUIRED]
ASR_ENDPOINT=asr.tencentcloudapi.com

# --- 腾讯云 TTS 语音合成 ---
TTS_PROVIDER=tencent
TTS_MODEL=cosvoice-v1
TTS_SPEAKER=longxiaochun
TTS_APP_ID=[REQUIRED]
TTS_SECRET_ID=[REQUIRED]
TTS_SECRET_KEY=[REQUIRED]
TTS_ENDPOINT=tts.tencentcloudapi.com

# --- 服务端口（可选，默认 8080）---
SERVER_PORT=8080